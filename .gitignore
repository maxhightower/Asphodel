__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.DS_Store

# Per-run CSV exports are regenerated by run.py; the committed example outputs
# (PNG/GIF + one baseline CSV) are kept for the handoff under output/.
output/*_aggregate.csv
!output/baseline_aggregate.csv

# Raw OSM response cache (large; regenerated on demand by asphodel.osm_city).
output/osm_cache/

# Raw public-data downloads (Overture parquet etc.); regenerated on demand by
# asphodel.world_source. The provenance manifest under geo/provenance/ is
# committed and describes exactly what these files contain.
data/raw/

# Rendered horizon/living-city screenshots (regenerate via godot/tests/*Shot.tscn)
/shots/
