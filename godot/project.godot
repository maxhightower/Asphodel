; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Asphodel"
run/main_scene="res://MainMenu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Session="*res://scripts/session.gd"
CollisionLayers="*res://scripts/collision_layers.gd"

[layer_names]

3d_physics/layer_1="world_static"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="vehicle"
3d_physics/layer_5="dynamic_prop"
3d_physics/layer_6="trigger"
3d_physics/layer_7="nav_query"
3d_physics/layer_8="damage_query"
